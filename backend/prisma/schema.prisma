  @@index([kind, issuedAt])
  @@map("document_verification_issues")
}

model CaseEpisode {
  id                         String                @id @default(uuid()) @db.Uuid
  clientId                   String                @map("client_id") @db.Uuid
  openedByUserId             String?               @map("opened_by_user_id") @db.Uuid
  sourceApplicantApplicationId String?             @unique @map("source_applicant_application_id") @db.Uuid
  title                      String                @db.VarChar(255)
  summary                    String?
  crisisStartedAt            DateTime?             @map("crisis_started_at") @db.Date
  status                     CaseEpisodeStatus     @default(open)
  createdAt                  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  client                     Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  openedByUser               User?                 @relation("case_episode_opened_by_user", fields: [openedByUserId], references: [id], onDelete: SetNull)
  sourceApplicantApplication ApplicantApplication? @relation(fields: [sourceApplicantApplicationId], references: [id], onDelete: SetNull)
  cases                      Case[]

  @@index([clientId, createdAt])
  @@index([status, updatedAt])
  @@map("case_episodes")
}
