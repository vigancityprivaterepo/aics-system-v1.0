model DocumentVerificationIssue {
  id                    String             @id @default(uuid()) @db.Uuid
  caseId                String             @map("case_id") @db.Uuid
  kind                  IssuedDocumentKind
  verificationCode      String             @map("verification_code") @db.VarChar(20)
  issuedCaseNumber      String             @map("issued_case_number") @db.VarChar(30)
  issuedAssistanceType  AssistanceType     @map("issued_assistance_type")
  issuedStatus          CaseStatus         @map("issued_status")
  issuedAmount          Decimal            @default(0.00) @map("issued_amount") @db.Decimal(12, 2)
  issuedClientName      String             @map("issued_client_name") @db.VarChar(255)
  issuedBeneficiaryName String?            @map("issued_beneficiary_name") @db.VarChar(255)
  issuedAt              DateTime           @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt             DateTime?          @map("revoked_at") @db.Timestamptz(6)
  metadata              Json?

  case                  Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)

