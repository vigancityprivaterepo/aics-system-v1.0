# Copy this file to .env.production on the Windows Server and fill every CHANGE_ME value.
# Do not commit .env.production.

# Published host ports. Bind to 127.0.0.1 when using the server Nginx reverse proxy.
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=5101
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=8081
PORTAL_BIND_HOST=127.0.0.1
PORTAL_PORT=8082

# Postgres container credentials
POSTGRES_USER=aics_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_DB=aics_db

# Backend runtime
PORT=5001
NODE_ENV=production
TRUST_PROXY=true
RATE_LIMIT_MODE=memory
API_BASE_URL=https://CHANGE_ME_API_DOMAIN_OR_SERVER_IP
CORS_ORIGIN=https://CHANGE_ME_STAFF_DOMAIN,https://CHANGE_ME_PORTAL_DOMAIN
PORTAL_URL=https://CHANGE_ME_PORTAL_DOMAIN
DATABASE_URL=postgresql://aics_prod:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/aics_db?schema=public

# Secrets: generate each with at least 32 random characters, and keep them different.
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS_STAFF_JWT
JWT_EXPIRES_IN=12h
PORTAL_JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS_PORTAL_JWT_DIFFERENT
PORTAL_JWT_EXPIRES_IN=7d
DOCUMENT_VERIFY_SECRET=CHANGE_ME_RANDOM_64_CHARS_DOCUMENT_VERIFY_DIFFERENT

# Business rules
BURIAL_GL_MAX_AMOUNT=10000
HOSPITAL_GL_MAX_AMOUNT=10000
PORTAL_EMAIL_NOTIFICATION_STATUSES=approved
UPLOAD_ROOT=uploads
BACKUPS_ROOT=backups

# SMTP: required because NODE_ENV=production
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=AICS Vigan City <noreply@vigancity.gov.ph>

# SMS: required because NODE_ENV=production
SEMAPHORE_API_KEY=CHANGE_ME_SEMAPHORE_API_KEY
SEMAPHORE_SENDER_ID=AICS

# OpenSign, optional unless you will use digital signing immediately
OPENSIGN_BASE_URL=
OPENSIGN_API_TOKEN=
OPENSIGN_CREATE_DOCUMENT_PATH=/api/v1/createdocument
OPENSIGN_WEBHOOK_SECRET=
OPENSIGN_WEBHOOK_URL=https://CHANGE_ME_API_DOMAIN_OR_SERVER_IP/api/documents/opensign/webhook

# AI findings assist, optional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google OAuth for applicant portal, optional if not using Google sign-in
GOOGLE_CLIENT_ID=

# Seed protection
ALLOW_PRODUCTION_SEED=false
